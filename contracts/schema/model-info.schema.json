{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rkodev/chatui/contracts/schema/model-info.schema.json",
  "title": "ChatUI Model Info",
  "contractVersion": 1,
  "oneOf": [
    {
      "$ref": "#/$defs/normalizedModel"
    },
    {
      "$ref": "#/$defs/rawCatalogEnvelope"
    }
  ],
  "$defs": {
    "normalizedModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "remoteId",
        "label",
        "contextWindow",
        "maxOutputTokens",
        "capabilities",
        "pricing",
        "canonicalSlug",
        "inputModalities",
        "outputModalities",
        "supportedParameters",
        "metadata",
        "hidden",
        "pinned",
        "source",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "remoteId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "contextWindow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "vision",
              "files",
              "tools",
              "reasoning",
              "streaming"
            ]
          }
        },
        "pricing": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inputPerMTok": {
                  "type": "number",
                  "minimum": 0
                },
                "outputPerMTok": {
                  "type": "number",
                  "minimum": 0
                },
                "perRequest": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "canonicalSlug": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputModalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "file",
              "audio",
              "video"
            ]
          }
        },
        "outputModalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio"
            ]
          }
        },
        "supportedParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "hidden": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "discovered",
            "preset",
            "manual"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rawCatalogEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        {
          "required": [
            "models"
          ],
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      ]
    }
  }
}
